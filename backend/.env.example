# Example environment configuration for the Flask backend.
# Copy this file to .env and adjust values as needed.
#
# CORS configuration:
# - The backend supports both CORS_ALLOW_ORIGINS (preferred) and the legacy
#   CORS_ALLOWED_ORIGINS variable for backwards compatibility.
# - If BOTH are set, CORS_ALLOWED_ORIGINS takes precedence.
# - Provide a comma-separated list of exact origins (scheme + host + optional port).
#
# IMPORTANT: Keep these two variables in sync. They should contain the exact same origins.

# Preferred variable (read first). Keep localhost present for local dev.
CORS_ALLOW_ORIGINS=http://localhost:3000, https://vscode-internal-34388-beta.beta01.cloud.kavia.ai:3000, https://vscode-internal-34388-beta.beta01.cloud.kavia.ai:4000

# Legacy variable (takes precedence if both are set). Mirrors the same origins as above.
CORS_ALLOWED_ORIGINS=http://localhost:3000, https://vscode-internal-34388-beta.beta01.cloud.kavia.ai:3000, https://vscode-internal-34388-beta.beta01.cloud.kavia.ai:4000

# Whether to include Access-Control-Allow-Credentials header (true/false)
CORS_ALLOW_CREDENTIALS=true

# Allowed headers for CORS (comma-separated)
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Allowed HTTP methods for CORS (comma-separated)
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Flask app configuration (optional)
FLASK_ENV=development
PORT=5000

# Database configuration (optional; used by identify_bears.py if run)
# Prefer a full SQLAlchemy URL; falls back to SQLite if omitted.
# SQLALCHEMY_DATABASE_URI=sqlite:///bear_data.db

# Logging level
LOG_LEVEL=INFO
