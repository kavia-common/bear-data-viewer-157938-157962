# CORS configuration
# Comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=http://localhost:3000, http://127.0.0.1:3000, https://vscode-internal-34388-beta.beta01.cloud.kavia.ai:3000, https://vscode-internal-34388-beta.beta01.cloud.kavia.ai:4000
# Whether to allow credentials
CORS_ALLOW_CREDENTIALS=true
# Comma-separated list of allowed headers
CORS_ALLOW_HEADERS=Content-Type, Authorization
# Comma-separated list of allowed methods
CORS_ALLOW_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
