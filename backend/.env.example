# Example environment variables for the Flask backend
# Copy this file to ".env" and adjust values as needed for your environment.
# On Unix:   cp .env.example .env
# On Windows: copy .env.example .env

# CORS configuration
# Comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=http://localhost:3000
# Whether to allow credentials (cookies, auth headers, TLS client certs)
CORS_ALLOW_CREDENTIALS=true
# Comma-separated list of allowed headers for CORS requests
CORS_ALLOW_HEADERS=Content-Type,Authorization
# Comma-separated list of allowed HTTP methods
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Optional: Flask settings
# FLASK_ENV=development
# FLASK_DEBUG=1
# PORT=3001
