# CORS configuration
# Comma-separated list of allowed origins.
# Precedence: CORS_ALLOW_ORIGINS (preferred) overrides CORS_ALLOWED_ORIGINS (legacy).
# Example:
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://vscode-internal-34388-beta.beta01.cloud.kavia.ai:3000,https://vscode-internal-34388-beta.beta01.cloud.kavia.ai:4000
CORS_ALLOW_ORIGINS=

# Legacy variable (still supported for backwards compatibility):
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Whether to include Access-Control-Allow-Credentials: true
CORS_ALLOW_CREDENTIALS=true

# Comma-separated list of request headers allowed in CORS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Comma-separated list of methods allowed in CORS
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Optional logging level (INFO, DEBUG, etc.)
LOG_LEVEL=INFO
