# Backend environment example
# Comma-separated list of allowed CORS origins for /api/* endpoints.
# If not set, defaults to: https://vscode-internal-20401-qa.qa01.cloud.kavia.ai:3000
# Example:
# BACKEND_CORS_ORIGINS=https://vscode-internal-20401-qa.qa01.cloud.kavia.ai:3000,https://my-other-origin.example.com
BACKEND_CORS_ORIGINS=

# Optional: Flask settings (if used elsewhere)
# FLASK_ENV=development
# LOG_LEVEL=INFO

# Database example (used by identify_bears.py if you enable it)
# SQLALCHEMY_DATABASE_URI=sqlite:///bear_data.db
