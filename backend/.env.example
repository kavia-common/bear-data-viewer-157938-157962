# Example environment variables for the Flask backend
# Copy this file to .env and adjust values for your environment.
# Usage:
#   cd backend && cp .env.example .env

# CORS configuration
# The backend supports both CORS_ALLOW_ORIGINS and legacy CORS_ALLOWED_ORIGINS.
# Specify a comma-separated list of exact origins (including scheme and port).
# Notes:
# - Origins must include explicit ports to match the browser's Origin header exactly.
# - For HTTPS domains, include :443 (e.g., https://example.com:443).
# - For local development, typical React dev server runs on port 3000.
#
# Examples:
#   - Local dev frontend:
#       http://localhost:3000, http://127.0.0.1:3000
#   - VS Code webview / cloud preview origins (replace placeholders with your actual hostname/port):
#       https://vscode-webview.net:443
#       https://vscode-internal-<workspace-id>-<port>.app.github.dev:443
#       https://vscode-internal-<workspace-id>-beta.beta01.cloud.kavia.ai:3000
#       https://vscode-internal-<workspace-id>-beta.beta01.cloud.kavia.ai:4000
#
# Guidance to find your exact VS Code / Codespaces origin:
# - Open the frontend app in the browser and copy the value of window.location.origin,
#   then add it here verbatim.
# - Ensure the value includes the port if present (e.g., :3000 for http, :443 for https).

# Prefer the newer variable name:
CORS_ALLOW_ORIGINS=http://localhost:3000, http://127.0.0.1:3000, https://vscode-webview.net:443

# Backwards compatibility (optional). If set, it will be used when CORS_ALLOW_ORIGINS is not set.
# You can set both; CORS_ALLOW_ORIGINS takes precedence.
#CORS_ALLOWED_ORIGINS=http://localhost:3000, http://127.0.0.1:3000, https://vscode-webview.net:443

# Whether to allow credentials (cookies, Authorization headers) across origins.
CORS_ALLOW_CREDENTIALS=true

# Comma-separated list of allowed headers for CORS requests.
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Comma-separated list of allowed HTTP methods for CORS.
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Flask app configuration (optional)
#FLASK_ENV=development
#FLASK_DEBUG=1
#PORT=5000

# Database (optional, used by identify_bears.py if enabled)
#SQLALCHEMY_DATABASE_URI=sqlite:///bear_data.db
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=10
