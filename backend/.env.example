# Environment variables for the Flask backend

# CORS configuration
# Multiple values are comma-separated. Whitespace around commas is ignored.
# Wildcards are supported by Flask-CORS when provided as strings with '*'.
# Include localhost for local dev and VS Code internal preview URLs.
# Note: Keep both legacy name (CORS_ALLOWED_ORIGINS) and preferred (CORS_ALLOW_ORIGINS).
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://vscode-internal.github.dev,https://*.vscode-internal.*.dev
# Preferred modern variable name; backend will read this first if set.
# Uncomment to override the above legacy variable:
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://vscode-internal.github.dev,https://*.vscode-internal.*.dev

# Whether to include Access-Control-Allow-Credentials: true
CORS_ALLOW_CREDENTIALS=true

# Comma-separated list of allowed headers
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Comma-separated list of allowed methods
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
