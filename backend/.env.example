# Environment variables for video_yolo_pipeline_2.py
# Copy this file to .env in the same backend directory and fill in values.

# AWS credentials and region for S3 operations
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=us-east-2

# MySQL RDS configuration (optional - if DB_HOST not set, DB ops will be skipped)
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Must be 'bear_stats' (the script will enforce this)
DB_NAME=bear_stats
